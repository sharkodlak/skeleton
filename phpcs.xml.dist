<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd"
         name="app">

    <arg name="severity" value="1"/>
    <arg name="cache" value="var/cache/phpcs.cache"/>

    <file>db</file>
    <file>src</file>
    <file>tests</file>
    <!--file>migrations</file-->

    <rule ref="ruleset.xml"></rule>


    <!-- Allow longer test files -->
    <rule ref="SlevomatCodingStandard.Files.FileLength">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Files.FileLength">
        <properties>
            <property name="maxLinesLength" value="1000"/>
        </properties>
        <include-pattern>tests/*</include-pattern>
    </rule>

    <!-- Allow long lines in seed files (SQL data rows can contain long JSON payloads) -->
    <rule ref="SlevomatCodingStandard.Files.LineLength.LineTooLong">
        <exclude-pattern>db/seeds/*</exclude-pattern>
    </rule>

    <!-- Phinx dictates the migration file name (20240824010101_enable_uuid_extension.php),
         which can never match the class name the rule expects. -->
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <exclude-pattern>db/migrations/*</exclude-pattern>
    </rule>

    <!-- A migration is one long linear script; splitting it up would hurt readability. -->
    <rule ref="SlevomatCodingStandard.Functions.FunctionLength">
        <properties>
            <property name="maxLinesLength" value="40"/>
        </properties>
        <include-pattern>db/migrations/*</include-pattern>
    </rule>

    <!-- Allow longer test classes -->
    <rule ref="SlevomatCodingStandard.Classes.ClassLength">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.ClassLength">
        <properties>
            <property name="maxLinesLength" value="1000"/>
        </properties>
        <include-pattern>tests/*</include-pattern>
    </rule>
</ruleset>
