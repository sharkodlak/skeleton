# log_format belongs to the http context, and files dropped into conf.d are
# already inside it. The 00- prefix makes this load before the server block that
# uses the format.
log_format with_request_id '$remote_addr - $remote_user [$time_local] '
                           '"$request" $status $body_bytes_sent '
                           '"$http_referer" "$http_user_agent" "$request_id"';
