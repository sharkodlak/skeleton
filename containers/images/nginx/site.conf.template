server {
	listen 80;
	server_name ${NGINX_SERVER_NAME};
	client_max_body_size 1M;

	access_log /var/log/nginx/host.access.log with_request_id;

	root /app/public;
	index index.html index.php;

	# Re-resolve the upstream instead of caching it for the lifetime of the
	# process; see docker-entrypoint-wrapper.sh for why.
	resolver ${DNS_RESOLVER} valid=10s ipv6=off;
	set $php_backend ${PHP_UPSTREAM};

	location /api/ {
		try_files $uri $uri/ /index.php$is_args$args;
	}

	location / {
		try_files $uri $uri/ /index.php$is_args$args;
	}

	location ~ \.php$ {
		root /app/public;
		fastcgi_split_path_info ^(.+?\.php)(/.*)$;
		fastcgi_index index.php;

		fastcgi_pass $php_backend;

		include fastcgi_params;
		# Hand the request id to PHP so application logs can be correlated with
		# the access log.
		fastcgi_param HTTP_X_REQUEST_ID $request_id;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		fastcgi_param PATH_INFO $fastcgi_path_info;
		fastcgi_param PATH_TRANSLATED $document_root$fastcgi_path_info;

		fastcgi_intercept_errors on;
	}
}
