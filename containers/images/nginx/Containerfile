FROM docker.io/library/nginx:mainline-alpine

EXPOSE 80

# Defaults that make the image usable on its own; compose overrides them.
ENV NGINX_SERVER_NAME=localhost \
    PHP_UPSTREAM=php:9000

# The entrypoint of the nginx image expands ${...} in /etc/nginx/templates only.
# A config placed straight into conf.d/ keeps the placeholders verbatim.
COPY ./containers/images/nginx/site.conf.template /etc/nginx/templates/default.conf.template

# Static assets travel with the image, so the container needs no bind mount.
COPY ./public /app/public

COPY ./containers/images/nginx/docker-entrypoint-wrapper.sh /docker-entrypoint-wrapper.sh
RUN chmod +x /docker-entrypoint-wrapper.sh

# Wraps the image's own entrypoint, which still renders the templates and
# runs the CMD inherited from the base image.
ENTRYPOINT ["/docker-entrypoint-wrapper.sh"]

# Declaring ENTRYPOINT resets the CMD inherited from the base image, so the
# command the entrypoint is supposed to exec has to be restated here.
CMD ["nginx", "-g", "daemon off;"]
